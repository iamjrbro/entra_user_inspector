# =========================================================
# Configuração do App Registration no Microsoft Entra ID
# =========================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).
#
# Observe que o CLIENT_SECRET NÃO aparece aqui: ele fica guardado no
# Azure Key Vault e é buscado em tempo de execução (ver src/keyvault.js
# e a seção "Azure Key Vault" do README.md).

# ID do Tenant (Directory ID) - encontrado em:
# Entra ID > Visão geral > ID do locatário
TENANT_ID=00000000-0000-0000-0000-000000000000

# ID do Aplicativo (Client ID) - encontrado em:
# Entra ID > Registros de aplicativo > <seu app> > Visão geral > ID do aplicativo (cliente)
CLIENT_ID=00000000-0000-0000-0000-000000000000

# =========================================================
# Azure Key Vault (onde o Client Secret fica armazenado)
# =========================================================

# URI do Key Vault - encontrado em:
# Key Vault > Visão geral > URI do vault
# Formato: https://<nome-do-keyvault>.vault.azure.net/
KEYVAULT_URI=https://SEU-KEYVAULT.vault.azure.net/

# Nome do secret dentro do Key Vault que contém o Client Secret do
# App Registration (o VALOR do secret, não o nome, é o que foi gerado
# em "Certificados e segredos" no passo 2.3 do README).
CLIENT_SECRET_NAME=entra-user-inspector-client-secret
