TENANT_ID=
CLIENT_ID=
KEYVAULT_URI=
CLIENT_SECRET_NAME=entra-user-inspector-client-secret
PORT=3000
HOST=127.0.0.1

# Autenticação do dashboard (separada da autenticação Graph acima).
APP_URL=http://localhost:3000
AUTH_DATABASE_PATH=./data/auth.sqlite
# Obrigatório no modo real, tanto para conta local quanto Microsoft.
AUTH_ALLOWED_EMAILS=operador@suaempresa.com
# JSON: e-mail -> SHA-256 de um código de convite aleatório.
# Necessário para criar contas com senha no modo real. Veja AUTHENTICATION.md.
AUTH_REGISTRATION_INVITES={}
# App Registration Web para SSO. Callback: APP_URL/auth/microsoft/callback
AUTH_MICROSOFT_TENANT_ID=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
